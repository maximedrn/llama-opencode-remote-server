# System configuration.
# cpu, nvidia, amd
BACKEND="cpu"
# Loopback port published by `--local`.
LOCAL_PORT=8080

# Llama configuration.
MODEL_DIRECTORY="~/.models"
MODEL_FILE=".gguf"
LLAMA_ALIAS=""

# Model parameters.
CTX_SIZE=262144
FIT_TARGET=768
LOAD_MODE="mmap+mlock"
FLASH_ATTN="auto"
CACHE_TYPE_K="q8_0"
CACHE_TYPE_V="q8_0"
SPEC_DRAFT_N_MAX=64
BATCH_SIZE=2048
UBATCH_SIZE=512
THREADS=8
THREADS_BATCH=16
NVIDIA_DEVICE="CUDA0"
AMD_DEVICE="ROCm0"

# Docker images.
LLAMA_CPU_IMAGE="ghcr.io/ggml-org/llama.cpp:server"
LLAMA_NVIDIA_IMAGE="ghcr.io/ggml-org/llama.cpp:server-cuda"
LLAMA_AMD_IMAGE="ghcr.io/ggml-org/llama.cpp:server-rocm"
PROXY_IMAGE="nginxinc/nginx-unprivileged:latest"
CLOUDFLARED_IMAGE="cloudflare/cloudflared:latest"
