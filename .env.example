# System configuration.
# cpu, nvidia, amd
BACKEND="cpu"
# Loopback port published by `--local`.
LOCAL_PORT=8080
# Compose file replacing docker/docker-compose.<backend>.yaml.
COMPOSE_OVERRIDE_FILE=""

# Llama configuration.
MODEL_DIRECTORY="~/.models"
MODEL_FILE=".gguf"
LLAMA_ALIAS=""

# Model parameters.
CTX_SIZE=262144
FIT_TARGET=768
LOAD_MODE="mmap+mlock"
FLASH_ATTN="auto"
CACHE_TYPE_K="q8_0"
CACHE_TYPE_V="q8_0"
SPEC_DRAFT_N_MAX=3
SPEC_DRAFT_P_MAX=0.7
BATCH_SIZE=2048
UBATCH_SIZE=512
THREADS=8
THREADS_BATCH=16
NVIDIA_DEVICE="CUDA0"
AMD_DEVICE="ROCm0"

# Keep-alive front, between the reverse proxy and llama.cpp.
KEEPALIVE="false"
# Silence tolerated before an SSE comment is sent, and how long `heartbeat
# check` waits for llama.cpp.
HEARTBEAT_KEEPALIVE_MS=10000
HEARTBEAT_TIMEOUT_MS=5000

# Docker images.
LLAMA_IMAGE=""
PROXY_IMAGE=""
CLOUDFLARED_IMAGE=""
