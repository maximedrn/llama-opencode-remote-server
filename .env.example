# Shared configuration (Docker and Windows native).
# Docker: cpu, nvidia, amd. Windows native: hip, vulkan.
BACKEND="cpu"
# Host loopback port for `--local`.
LOCAL_PORT=8080
MODEL_DIRECTORY="~/.models"
MODEL_FILE=".gguf"
LLAMA_ALIAS=""

# Shared llama.cpp model parameters.
# Choose a context that fits your GPU. For Windows native, start at 32768.
CTX_SIZE=262144
FIT_TARGET=768
LOAD_MODE="mmap+mlock"
FLASH_ATTN="auto"
CACHE_TYPE_K="q8_0"
CACHE_TYPE_V="q8_0"
# Draft length for speculative decoding. Set to 0 to disable it on native.
SPEC_DRAFT_N_MAX=3
BATCH_SIZE=2048
UBATCH_SIZE=512
THREADS=8
THREADS_BATCH=16
# Optional GPU device. Defaults to ROCm0, CUDA0 or Vulkan0 for the backend.
DEVICE=""

# Windows native only (hip or vulkan).
# Full path to llama-server.exe from a matching Windows build.
NATIVE_SERVER_PATH="llama-server.exe"

# Docker only (cpu, nvidia or amd).
# Compose file replacing docker/docker-compose.<backend>.yaml.
COMPOSE_OVERRIDE_FILE=""
SPEC_DRAFT_P_MAX=0.7

# llama.cpp keeps the stream warm by itself: an SSE ping every N seconds while
# it is still processing the prompt (-1 disables it), and its own read/write
# timeout before it cancels the task it is working on.
SSE_PING_INTERVAL=15
LLAMA_TIMEOUT=3600

# Keep-alive front, between the reverse proxy and llama.cpp.
KEEPALIVE="false"
# Silence tolerated before an SSE comment is sent, and how long `heartbeat
# check` waits for llama.cpp.
HEARTBEAT_KEEPALIVE_MS=10000
HEARTBEAT_TIMEOUT_MS=5000
# Logs the request and answer bodies of every relayed call. For diagnosing an
# agent that hangs on a tool call; prompts land in the logs, so keep it empty
# the rest of the time.
HEARTBEAT_TRACE=

# Docker images.
LLAMA_IMAGE=""
PROXY_IMAGE=""
CLOUDFLARED_IMAGE=""
# `missing` pulls what is not on this machine yet; use `never` when LLAMA_IMAGE
# names an image you built locally, so `stack pull` skips it instead of trying
# to pull a repository that does not exist.
LLAMA_PULL_POLICY="missing"
