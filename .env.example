# System configuration.
# cpu, nvidia, amd
BACKEND="cpu"
# Loopback port published by `--local`.
LOCAL_PORT=8080
# Extra Compose file layered after the backend one, for a machine-specific
# override. Not named COMPOSE_FILE: Compose reads that variable itself.
COMPOSE_OVERRIDE_FILE=""

# Llama configuration.
MODEL_DIRECTORY="~/.models"
MODEL_FILE=".gguf"
LLAMA_ALIAS=""

# Model parameters.
CTX_SIZE=262144
FIT_TARGET=768
LOAD_MODE="mmap+mlock"
FLASH_ATTN="auto"
CACHE_TYPE_K="q8_0"
CACHE_TYPE_V="q8_0"
SPEC_DRAFT_N_MAX=3
SPEC_DRAFT_P_MAX=0.7
BATCH_SIZE=2048
UBATCH_SIZE=512
THREADS=8
THREADS_BATCH=16
NVIDIA_DEVICE="CUDA0"
AMD_DEVICE="ROCm0"

# Heartbeat: polls llama.cpp, logs what it sees, answers the healthcheck.
HEARTBEAT_INTERVAL_MS=15000
HEARTBEAT_TIMEOUT_MS=5000

# Docker images. Leave them empty to run the image each Compose file already
# defaults to (`:server`, `:server-cuda`, `:server-rocm` for llama.cpp); set
# LLAMA_IMAGE to pin one build for every backend, for instance when a published
# tag lags upstream.
LLAMA_IMAGE=""
PROXY_IMAGE=""
CLOUDFLARED_IMAGE=""
