{
  "$schema": "https://opencode.ai/config.json",
  "model": "llama/default",
  "provider": {
    "llama": {
      "models": {
        "default": {
          "name": "llama.cpp"
        }
      },
      "name": "llama.cpp",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "apiKey": "{env:LLAMA_API_KEY}",
        "baseURL": "{env:LLAMA_BASE_URL}/v1",
        "chunkTimeout": 3600000,
        "timeout": 3600000
      }
    }
  }
}
