# Base URL of the llama.cpp server.
# Local:  http://127.0.0.1:8080  (or the LOCAL_PORT you set in .env)
# Remote: https://llm.example.com  (the Cloudflare Tunnel hostname)
LLAMA_BASE_URL=""

# Llama API key, printed as a fingerprint by `bun run stack init`.
LLAMA_API_KEY=""

# Cloudflare Access service token. Remote mode only, leave empty locally.
CLOUDFLARE_ACCESS_CLIENT_ID=""
CLOUDFLARE_ACCESS_CLIENT_SECRET=""
